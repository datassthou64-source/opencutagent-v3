# Transcription runs LOCALLY via HyperFrames whisper (whisper.cpp) — no API key,
# no network, no per-minute cost. Requires the `hyperframes` CLI to be reachable
# (via npx) with whisper.cpp installed. Every setting below is also editable from
# the panel's settings > Advanced accordion.
EDITAGENT_AI_TIMEOUT_MS=900000
# Note: the "AI analysis" (retake keep/cut, silence threshold) is done by Claude
# itself on your Claude *subscription* — no separate AI API key or credits. With
# "Sync with Claude Code" ON it runs via MCP tools in your chat; OFF (default) the
# panel runs `claude` headlessly for you (see the Panel AI section below).
#
# The Remove Silences tab is loudness-based (ffmpeg only): it needs no transcription
# at all, so it works with no extra setup.

# Optional: bridge port shared by the MCP server and the Premiere panel.
# Default 3001. If you change it, the panel auto-reads the negotiated port
# from ~/.editagent/bridge-port, so you normally don't need to touch the panel.
# PREMIERE_BRIDGE_PORT=3001

# Optional: override the transcript cache directory (default: <project>/.cache).
# EDITAGENT_CACHE_DIR=

# Optional: path to ffmpeg if not on PATH.
# FFMPEG_BIN=ffmpeg

# Transcription is scoped to what's ON THE TIMELINE (only the used clip source ranges
# are transcribed — off-timeline footage is skipped; a reload after cutting reuses a
# union cache and re-transcribes nothing). These tune how the used ranges are grouped
# into the few continuous "islands" that get transcribed:
#   MERGE_GAP — coalesce ranges closer than this many seconds into one island (bigger =
#   fewer whisper calls but re-includes more in-between audio; default 5).
#   PAD — seconds of context kept on each island edge so edge words aren't clipped (default 0.25).
# EDITAGENT_TRANSCRIBE_MERGE_GAP=5
# EDITAGENT_TRANSCRIBE_PAD=0.25

# Transcription engine/model used when the panel doesn't send one: scribe_v2 (ElevenLabs,
# verbatim, needs ELEVENLABS_API_KEY) or a whisper model below. Blank = Scribe if a key is
# set, else whisper. The panel's Transcription dropdown overrides this.
# EDITAGENT_TRANSCRIBE_MODEL=scribe_v2
# EDITAGENT_SCRIBE_RATE=0.22

# Local whisper model (the panel's Transcription dropdown overrides this).
# Options: tiny.en, base.en, small.en, medium.en, large-v3. Bigger = more accurate, slower.
# EDITAGENT_WHISPER_MODEL=small.en

# Retakes segment granularity (the "Load segments" chunk size). Smaller segments =
# finer keep/cut control over what to delete; larger = fewer, longer segments.
#   GAP — split a clip into a new segment on an internal pause this long, seconds (default 0.5).
#   SPLIT_SENTENCE — also split at sentence punctuation . ? ! so each segment is ~one
#     sentence (default on; set to 0 to disable and split on pauses only).
#   MAX_WORDS — hard-cap a run-on with no punctuation/pauses at this many words (default 14).
# EDITAGENT_PHRASE_GAP_SEC=0.5
# EDITAGENT_PHRASE_SPLIT_SENTENCE=1
# EDITAGENT_PHRASE_MAX_WORDS=14

# ── Panel AI actions ("Calculate by AI" / "Analyze w/ Claude") ───────────────
# With "Sync with Claude Code" OFF (the default), these buttons run the `claude`
# CLI HEADLESSLY on your Claude *subscription* (keychain login — no API key, no
# extra credits) so you never have to type a prompt in chat. The panel's
# Model/Effort dropdowns set these per call; the values below are only fallback
# defaults used when the panel doesn't send them.
#
# Model: "latest" (your Claude Code default) or an alias: opus / sonnet / haiku / fable.
# EDITAGENT_AI_MODEL=latest
# Effort: low | medium | high | xhigh | max.
# EDITAGENT_AI_EFFORT=high
# Hard timeout for one headless call, ms (default 600000 = 10 min). Raise it for
# big retake analyses on Opus/Max over a long transcript.
# EDITAGENT_AI_TIMEOUT_MS=900000
# Full path to `claude` if it isn't auto-found (we try this, then ~/.local/bin/claude,
# /usr/local/bin, /opt/homebrew/bin, then PATH).
# EDITAGENT_CLAUDE_BIN=/Users/you/.local/bin/claude
#
# Auth: the headless call reuses your existing `claude` login and scrubs
# ANTHROPIC_API_KEY so it never silently bills a pay-per-token key. On a headless
# box with no keychain, run `claude setup-token` and export CLAUDE_CODE_OAUTH_TOKEN.

# ── How "Analyze w/ Claude" finds retakes ────────────────────────────────────
# Fast mode cuts direct repeated-prefix and high-similarity retry matches
# found ON THIS MACHINE. Lower-confidence matches stay Keep. Hybrid uses the broader
# detector and sends only genuinely unclear groups to Claude in one small call.
#
# MODE:
#   fast (default)   only certain local matches; uncertain speech stays Keep
#   hybrid           broader local matching, then Claude reviews the unclear groups
#   ai               the original path: the whole timeline, chunked into ~24 calls (slow)
# EDITAGENT_RETAKE_MODE=fast
#
# ESCALATE — how much hybrid mode hands to Claude:
#   tight (default) only groups where no take is clean, or where two clean takes may
#                   be two different points rather than one line restarted
#   wide            every group with more than one complete take (more accurate, still one call)
# EDITAGENT_RETAKE_ESCALATE=tight
#
# Effort for that small review call. The model only picks a keeper inside an
# already-grouped run, so high effort buys nothing here.
# EDITAGENT_RETAKE_EFFORT=medium
# Max segments bundled into one review call, and how many run at once.
# EDITAGENT_RETAKE_GROUP_BATCH=120
# EDITAGENT_RETAKE_GROUP_CONCURRENCY=2

# Retake V2's "AI word cuts" button always reviews the FULL transcript through
# Claude. It uses compact ~900-word owner windows with overlap, then sends only
# suspicious passages through a second word-indexed pass for exact cut boundaries.
# Sonnet + low effort is the built-in default for this dedicated path.
# EDITAGENT_RETAKE_V2_CHUNK_WORDS=900
# EDITAGENT_RETAKE_V2_CONTEXT_WORDS=120
# EDITAGENT_RETAKE_V2_PRECISION_WORDS=1000
# EDITAGENT_RETAKE_V2_CONCURRENCY=4
